# Copia este archivo a ".env" (en la raiz del proyecto, junto a package.json)
# y reemplaza los valores. ".env" esta en .gitignore: nunca se sube al repo.

# Firebase / Google Cloud (uno de los dos basta)
GOOGLE_CLOUD_PROJECT=tu-proyecto-id
# FIREBASE_PROJECT_ID=tu-proyecto-id

# Firebase Web API key (Firebase Console > Configuracion del proyecto > General > apiKey)
FIREBASE_WEB_API_KEY=tu-web-api-key

# Asistente virtual (chatbot, solo administradores) - OpenAI
OPENAI_API_KEY=sk-tu-api-key
# OPENAI_MODEL=gpt-4o-mini

# Evidencia fotografica de atenciones/seguimientos - Cloudinary
# (Dashboard de Cloudinary > Account Details, la URL ya viene armada)
CLOUDINARY_URL=cloudinary://tu-api-key:tu-api-secret@tu-cloud-name

# Opcional
# PORT=3000
